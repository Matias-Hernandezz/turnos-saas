# --- App ---
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api

# --- Database ---
DATABASE_URL=postgresql+psycopg://turnos:turnos@localhost:5432/turnos_saas

# --- JWT (generar valores fuertes en producción) ---
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_ISSUER=turnos-saas
JWT_AUDIENCE=turnos-saas-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Cifrado tokens MP (Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ---
FERNET_KEY=

# --- CORS (coma separada) ---
CORS_ORIGINS=http://localhost:5173

# --- Proxy / tenant routing ---
TRUST_PROXY_HEADERS=false
DEFAULT_PUBLIC_HOST=localhost:5173
PUBLIC_APP_BASE_URL=http://localhost:5173

# --- Email transaccional (opcional en dev) ---
EMAIL_FROM=noreply@turnos.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Anti-abuso API pública ---
PUBLIC_RATE_LIMIT_PER_MINUTE=60
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_ENABLED_IN_TEST=false

# --- Mercado Pago (opcional en MVP) ---
MP_WEBHOOK_SECRET_TENANT_PAYMENTS=
MP_WEBHOOK_SECRET_SUBSCRIPTIONS=
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api
